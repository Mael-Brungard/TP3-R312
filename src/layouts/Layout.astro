---
import "../styles/global.css";
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Penguin Atlas</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <header class="border-b border-white/10 bg-slate-950/95">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-8"
      >
        <a href="/" class="group flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400 text-xl text-slate-950 shadow-lg shadow-cyan-400/20"
            >P</span
          >
          <span>
            <span
              class="block text-sm font-black uppercase tracking-[0.24em] text-cyan-300"
              >Penguin</span
            >
            <span
              class="block text-xs font-medium uppercase tracking-[0.18em] text-slate-400"
              >Atlas des espèces</span
            >
          </span>
        </a>

        <label class="sr-only" for="page-navigation"
          >Navigation principale</label
        >
        <select
          id="page-navigation"
          class="rounded-full border border-white/15 bg-slate-900 px-4 py-2 text-sm font-semibold text-slate-100 outline-none transition focus:border-cyan-300 focus:ring-2 focus:ring-cyan-300/30"
          aria-label="Navigation principale"
        >
          <option value="/" selected={currentPath === "/"}>Accueil</option>
          <option value="/species/" selected={currentPath === "/species/"}
            >Slider</option
          >
          <option
            value="/species/tabs/"
            selected={currentPath === "/species/tabs/"}>Onglets</option
          >
          <option
            value="/species/adelie/"
            selected={currentPath === "/species/adelie/"}>Adelie</option
          >
          <option
            value="/species/chinstrap/"
            selected={currentPath === "/species/chinstrap/"}>Chinstrap</option
          >
          <option
            value="/species/gentoo/"
            selected={currentPath === "/species/gentoo/"}>Gentoo</option
          >
        </select>
      </div>
    </header>
    <div class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full bg-cyan-400/10 blur-3xl"
      >
      </div>
      <slot />
    </div>
    <footer
      class="border-t border-white/10 px-6 py-8 text-center text-xs uppercase tracking-[0.2em] text-slate-500"
    >
      Données d’observation des manchots
    </footer>
  </body>
</html>

<script>
  document
    .querySelector<HTMLSelectElement>("#page-navigation")
    ?.addEventListener("change", (event) => {
      const value = (event.target as HTMLSelectElement).value;
      location.pathname = value;
    });
</script>
