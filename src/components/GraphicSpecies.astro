---
const { species } = Astro.props;
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const filteredPenguins =
    species == null
        ? penguins
        : penguins.filter((penguin) => penguin.species === species);
---

<div
    class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-950/20 sm:p-5"
>
    <PlotFigure
        options={{
            style: {
                color: "#0f172a",
                background: "transparent",
            },
            marks: [
                Plot.dot(filteredPenguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                }),
            ],
        }}
    />
</div>
