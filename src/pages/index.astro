---
import Layout from "../layouts/Layout.astro";
import penguins from "../assets/penguins.json";
import GraphicSpecies from "../components/GraphicSpecies.astro";

const speciesCount = new Set(penguins.map(({ species }) => species)).size;
---

<Layout>
  <main class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-20">
    <section class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p
          class="mb-5 text-sm font-bold uppercase tracking-[0.3em] text-cyan-300"
        >
          Carnet de terrain · Antarctique
        </p>
        <h1
          class="max-w-3xl text-5xl font-black tracking-tight text-white sm:text-6xl lg:text-7xl"
        >
          Lire les espèces à travers leurs silhouettes.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-400">
          Explorez les mesures morphologiques de trois populations de manchots
          et comparez leurs profils en un coup d’œil.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/species"
            class="rounded-full bg-cyan-400 px-6 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300"
            >Explorer les espèces <span aria-hidden="true">→</span></a
          >
          <a
            href="#graphique"
            class="rounded-full border border-white/20 px-6 py-3 text-sm font-bold text-white transition hover:border-white/50 hover:bg-white/10"
            >Voir le graphique</a
          >
        </div>
      </div>

      <div
        class="relative rounded-4xl border border-cyan-300/20 bg-cyan-300/10 p-8 sm:p-12"
      >
        <div
          class="absolute right-8 top-8 h-24 w-24 rounded-full border border-cyan-200/30"
        >
        </div>
        <div
          class="absolute right-14 top-14 h-12 w-12 rounded-full bg-cyan-300/20"
        >
        </div>
        <p
          class="relative text-8xl font-black tracking-tighter text-cyan-300 sm:text-9xl"
        >
          03
        </p>
        <p class="relative mt-3 max-w-xs text-xl font-bold text-white">
          espèces observées dans une même grille de lecture.
        </p>
        <div
          class="relative mt-12 grid grid-cols-2 gap-4 border-t border-white/15 pt-5 text-sm text-slate-400"
        >
          <span
            ><strong class="block text-2xl text-white">{penguins.length}</strong
            >observations</span
          >
          <span
            ><strong class="block text-2xl text-white">{speciesCount}</strong
            >populations</span
          >
        </div>
      </div>
    </section>

    <section id="graphique" class="mt-20 scroll-mt-8">
      <div
        class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
      >
        <div>
          <p
            class="text-sm font-bold uppercase tracking-[0.25em] text-cyan-300"
          >
            Vue d’ensemble
          </p>
          <h2 class="mt-2 text-3xl font-black text-white">
            Longueur et profondeur du culmen
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-6 text-slate-400">
          Chaque point représente un individu. La couleur distingue les espèces.
        </p>
      </div>
      <GraphicSpecies />
    </section>
  </main>
</Layout>
