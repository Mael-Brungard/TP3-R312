---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
---

<Layout>
    <main class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
        <div class="max-w-2xl">
            <p
                class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-300"
            >
                Catalogue morphologique
            </p>
            <h1
                class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl"
            >
                Les différentes espèces
            </h1>
            <p class="mt-5 text-lg leading-8 text-slate-400">
                Faites défiler les profils pour comparer les mesures des trois
                populations.
            </p>
        </div>

        <label class="sr-only" for="species-anchor-navigation"
            >Navigation des espèces</label
        >
        <select
            id="species-anchor-navigation"
            class="mt-8 rounded-full border border-white/15 bg-slate-900 px-5 py-2.5 text-sm font-bold text-slate-100 outline-none transition focus:border-cyan-300 focus:ring-2 focus:ring-cyan-300/30"
            aria-label="Navigation des espèces"
        >
            <option value="adelie" selected>Adelie</option>
            <option value="chinstrap">Chinstrap</option>
            <option value="gentoo">Gentoo</option>
        </select>

        <div
            data-species-slider
            class="-mx-6 mt-8 flex overflow-x-auto px-6 scroll-smooth lg:-mx-8 lg:px-8"
        >
            <section
                id="adelie"
                class="item w-2/3 shrink-0 scroll-mt-8 pr-4"
                aria-labelledby="adelie-title"
            >
                <h2
                    id="adelie-title"
                    class="mb-5 text-2xl font-black text-white"
                >
                    Adelie
                </h2>
                <GraphicSpecies species="Adelie" />
            </section>
            <section
                id="chinstrap"
                class="item w-2/3 shrink-0 scroll-mt-8 pr-4"
                aria-labelledby="chinstrap-title"
            >
                <h2
                    id="chinstrap-title"
                    class="mb-5 text-2xl font-black text-white"
                >
                    Chinstrap
                </h2>
                <GraphicSpecies species="Chinstrap" />
            </section>
            <section
                id="gentoo"
                class="item w-2/3 shrink-0 scroll-mt-8 pr-4"
                aria-labelledby="gentoo-title"
            >
                <h2
                    id="gentoo-title"
                    class="mb-5 text-2xl font-black text-white"
                >
                    Gentoo
                </h2>
                <GraphicSpecies species="Gentoo" />
            </section>
        </div>
    </main>
</Layout>

<script>
    const slider = document.querySelector<HTMLElement>("[data-species-slider]");
    const speciesNavigation = document.querySelector<HTMLSelectElement>(
        "#species-anchor-navigation",
    );
    const items = document.querySelectorAll<HTMLElement>(".item");

    const setActiveSpecies = (species: string) => {
        if (speciesNavigation) speciesNavigation.value = species;
    };

    const centerSection = (section: HTMLElement) => {
        if (!slider) return;

        const sectionOffset = section.offsetLeft - slider.offsetLeft;
        const centeredOffset =
            sectionOffset - (slider.clientWidth - section.offsetWidth) / 2;
        const maxOffset = slider.scrollWidth - slider.clientWidth;

        slider.style.scrollBehavior = "auto";
        slider.scrollLeft = Math.max(0, Math.min(centeredOffset, maxOffset));
    };

    speciesNavigation?.addEventListener("change", (event) => {
        const species = (event.target as HTMLSelectElement).value;
        const section = species ? document.getElementById(species) : null;

        if (slider && section && species) {
            location.hash = species;
            window.setTimeout(() => centerSection(section), 0);
            setActiveSpecies(species);
        }
    });

    if (slider) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const id = entry.target.getAttribute("id");
                    if (entry.isIntersecting) {
                        if (id) setActiveSpecies(id);
                    }
                });
            },
            { root: slider, threshold: 0.75 },
        );

        items.forEach((item) => observer.observe(item));

        const initialSpecies = window.location.hash.slice(1);
        const initialSection = initialSpecies
            ? document.getElementById(initialSpecies)
            : null;
        if (initialSection) {
            centerSection(initialSection);
            setActiveSpecies(initialSpecies);
        }
    }
</script>
